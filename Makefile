# Makefile for beads.el.
#
# Package-specific settings only; every shared rule lives in
# Makefile.common, an identical copy of the canonical file in
# ~/.emacs.d/modules/dmg (see its header).  Run `make help' for the
# target list, and see the header of Makefile.common for what each
# variable below controls.
#
# The mise tasks and scripts/*.py remain for upstream's workflow; this
# Makefile is the one used together with the dmg packages.

PACKAGE = beads

# Sources live in lisp/, not at the package root.  Every file is
# compiled with lisp/ on the load-path, so each one requires its
# siblings from source and the order below does not matter.
EL_FILES = $(sort $(wildcard lisp/*.el))
EXTRA_LOAD_PATH = -L lisp

# Runtime dependencies (vui, transient) come from Package-Requires and
# are installed by Makefile.common; the tests need nothing more.
DEPS =

# Unit tests only.  `test' excludes every test tagged :integration.
# Of those, only the ones also tagged :cli drive a real bd CLI in
# temporary workspaces; they run with `make test-integration'.  The
# remaining :integration tests are legacy daemon tests, some tagged
# :destructive, that act on whatever beads workspace the current
# directory belongs to, so no target runs them.
CUSTOM_TEST = yes

# The manual is docs/beads.texi, generated by the upstream docs task;
# the Info rules of Makefile.common expect the package-root layout.
INFO_SRC =

EXTRA_CLEAN = lisp/*.elc

HELP_EXTRA = "  make test-integration" \
             "                      run the CLI integration tests (needs bd)"

include Makefile.common

.PHONY: test test-integration

test: $(ELPA_DIR)/.installed
	$(EMACS_BATCH) -L . -L $(TEST_DIR) \
	  $(foreach f,$(TEST_FILES),-l $(f)) \
	  --eval "(ert-run-tests-batch-and-exit '(not (tag :integration)))"

# Prints the bd version first, so a result can be tied to the CLI it
# ran against.
test-integration: $(ELPA_DIR)/.installed
	@echo "==> bd: $$(bd --version 2>/dev/null | head -1)"
	$(EMACS_BATCH) -L . -L $(TEST_DIR) \
	  $(foreach f,$(TEST_FILES),-l $(f)) \
	  --eval "(ert-run-tests-batch-and-exit '(tag :cli))"
